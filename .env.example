# Application Environment (development, testing, production)
APP_ENV=development

# Session Signing Secret (Required in production: minimum 32 random characters)
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters

# Database Persistence
DATABASE_URL=sqlite:///./adaptive_rag.db

# Embedding & Retrieval Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
DENSE_WEIGHT=0.65
BM25_WEIGHT=0.35
ENABLE_RERANKER=false

# LLM Provider Configuration (groq, gemini, ollama)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Settings (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Adaptive Evaluation Threshold
EVALUATION_THRESHOLD=0.65
